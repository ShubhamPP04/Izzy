    <!-- Version 1.1.3 -->
    <item>
      <title>Version 1.1.3</title>
      <description>
        <![CDATA[
          <ul>
            <li>Enhanced mini player with smart resume functionality</li>
            <li>Menu bar player now resumes from last playback position</li>
