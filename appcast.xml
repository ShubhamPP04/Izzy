    <!-- Initial release -->
    <item>
      <title>Version 1.0</title>
      <description>
        <![CDATA[
          <ul>
            <li>Initial release of Izzy</li>
            <li>Real-time YouTube Music search with intelligent suggestions</li>
            <li>Global hotkey support (Option + Space)</li>
            <li>Floating window interface that appears above all applications</li>
            <li>Persistent playback state and search context</li>
            <li>Recently played music tracking</li>
            <li>Native macOS media key integration</li>
          </ul>
        ]]>
      </description>
